# PostgreSQL
POSTGRES_DB=crawler
POSTGRES_USER=crawler
POSTGRES_PASSWORD=crawlerpass

# MinIO (S3-compatible blob storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# LLM Configuration
# Provider: "claude_code" | "anthropic" | "openai" | "ollama" (local)
#
# claude_code shells out to the local `claude` CLI, so calls draw against a
# Pro/Max subscription and no API key is needed. Each call is a process cold
# start (~3.5s) with a fixed ~6.5k-token system prompt, which is fine for a
# nightly incremental refresh and painful for a full backfill.
#
# Requires `claude` on PATH and logged in (`claude auth`). For CI, mint a
# long-lived token with `claude setup-token` and set CLAUDE_CODE_OAUTH_TOKEN.
LLM_PROVIDER=claude_code
LLM_MODEL=claude-sonnet-5
# CLAUDE_BIN=claude

# Metered API alternative — per-token billing, but no subscription rate limits
# and true concurrency. Use this for the initial full crawl.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5
# LLM_API_KEY=

# Local alternative — free, but noticeably weaker at structured extraction:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
# LLM_BASE_URL=http://host.docker.internal:11434

# Logging
LOG_LEVEL=INFO
